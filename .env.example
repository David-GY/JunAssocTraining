# Shared editing password; use at least 8 characters for new installs. No user accounts are stored.
EDITOR_PASSWORD=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITOR_SESSION_SECRET=
# Optional Neon Postgres alternative. Vercel needs Blob or Postgres; local dev can use .local-data/.
DATABASE_URL=
# Existing Vercel deployment: private Blob store takes priority over Postgres.
BLOB_READ_WRITE_TOKEN=
