# Shared editing password, at least 8 characters. No user accounts are stored.
EDITOR_PASSWORD=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITOR_SESSION_SECRET=
# Neon Postgres connection string. Required on Vercel. Local dev uses .local-data/ if unset.
DATABASE_URL=
